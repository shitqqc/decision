<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="StanceTree">
    <ReactiveSequence name="StanceTreeRoot">
      <UpdateStanceDuration />
      
      <ReactiveFallback name="StancePriorityRoot">
        <ReactiveSequence name="MoveStanceNoSpinBranch">
          <ChangeStance name="ChangeStanceMoveNoSpin" stance="MOVE" cooldown="5.0"/>
          <Script code="spin_enabled := !through_tunnel" />
          <SetSpinState use_spin="{spin_enabled}" />
        </ReactiveSequence>

        <!-- 敌方防守区受击后优先使用强化防御；连续5秒未再掉血后退出。
             优先级低于过洞，高于其他姿态分支。强化不可用时回退现有正常姿态决策。 -->
        <ReactiveSequence name="EnemyDefenseDamageDefendBranch">
          <CheckEnemyDefenseHealthDrop stable_seconds="5.0" />
          <CheckShouldEnhanceStance target_stance="DEFEND"
                                    min_remaining_sec="1"
                                    force_if_available="true" />
          <ChangeStance name="ChangeStanceEnemyDefenseDamageEnhancedDefend"
                        stance="ENHANCED_DEFEND"
                        cooldown="5.0" />
        </ReactiveSequence>

        <!-- 锁定2号装甲板时，强化攻击可用即启用；
             优先级紧随敌方防守区受击强化防御，条件不满足时回退现有姿态决策。 -->
        <ReactiveSequence name="StairsTargetEnhancedAttackBranch">
          <CheckTargetArmorId target_id="2" />
          <CheckShouldEnhanceStance target_stance="ATTACK"
                                    min_remaining_sec="1"
                                    force_if_available="true" />
          <ChangeStance name="ChangeStanceStairsTargetEnhancedAttack"
                        stance="ENHANCED_ATTACK" 
                        cooldown="5.0" />
        </ReactiveSequence>

        <!-- 前哨强化防御共用分支：保留每次撤退最初5秒；前哨RESPONSE目标下血量较进入目标时下降5个百分点，本局额外触发一次固定5秒。 -->
        <ReactiveSequence name="OutpostEnhancedDefendBranch">
          <Fallback name="OutpostEnhancedDefendTriggerSelector">
            <CheckOutpostAttackState name="CheckOutpostRetreatEnhancedDefendActive"
                                     state="enhanced_defend" />
            <CheckOutpostLowHealthDefend name="CheckOutpostLowHealthDefend"
                                         health_drop_threshold="5"
                                         hold_seconds="5.0"
                                         goal_distance_threshold="0.5" />
          </Fallback>
          <ChangeStance name="ChangeStanceOutpostRetreatEnhancedDefend"
                        stance="ENHANCED_DEFEND" 
                        cooldown="5.0" />
        </ReactiveSequence>

        <!-- 敌区受击强化防御：冲堡接近阶段继续执行 MOVE/零陀螺/航向对齐，
             只有到达堡垒交战圈后才允许该分支接管冲堡姿态。 -->
        <ReactiveSequence name="EnemyAreaHurtEnhancedDefendBranch">
          <CheckEnemyAreaRecentlyHurt hold_seconds="5.0" />
          <CheckShouldEnhanceStance
            target_stance="DEFEND"
            accumulated_threshold="170"
            fallback_game_time="60"
            min_remaining_sec="1"
            force_if_available="true" />
          <ReactiveFallback name="EnemyAreaHurtContextSelector">
            <Sequence name="ArrivedEnemyFortHurtEnhancedDefend">
              <CheckTacticalModeCondition mode="attack" />
              <SetSpinState use_spin="true" />
              <ChangeStance name="ChangeStanceArrivedEnemyFortHurtEnhancedDefend"
                            stance="ENHANCED_DEFEND" 
                            cooldown="5.0" />
            </Sequence>
            <Sequence name="NonAttackEnemyAreaHurtEnhancedDefend">
              <Inverter>
                <CheckTacticalModeCondition mode="attack" />
              </Inverter>
              <SetSpinState use_spin="true" />
              <ChangeStance name="ChangeStanceEnemyAreaHurtEnhancedDefend"
                            stance="ENHANCED_DEFEND" 
                            cooldown="5.0" />
            </Sequence>
          </ReactiveFallback>
        </ReactiveSequence>

        <ReactiveSequence name="AttackFortDefendSpinBranch">
          <CheckTacticalModeCondition mode="attack" />
          <ReactiveFallback name="EnemyFortStanceSelector">
            <Sequence name="ArrivedEnemyFortDefendSpin">
              <SetSpinState use_spin="true" />
              <Fallback name="FortDefendStanceSelector">
                <Sequence name="TryEnhancedDefend">
                  <CheckShouldEnhanceStance
                    target_stance="DEFEND"
                    accumulated_threshold="170"
                    fallback_game_time="60"
                    min_remaining_sec="1" />
                  <ChangeStance name="ChangeStanceArrivedEnemyFortEnhancedDefend" stance="ENHANCED_DEFEND" cooldown="5.0" />
                </Sequence>
                <ChangeStance name="ChangeStanceArrivedEnemyFortDefend" stance="DEFEND" cooldown="5.0" />
              </Fallback>
            </Sequence>
            <Sequence name="ApproachEnemyFortMoveZeroSpin">
              <!-- <Inverter>
                <CheckInEnemyFortZone />
              </Inverter> -->
              <SetSpinState use_spin="false" />
              <Fallback name="FortMoveStanceSelector">
                <Sequence name="TryEnhancedMove">
                  <CheckShouldEnhanceStance
                    target_stance="MOVE"
                    accumulated_threshold="170"
                    fallback_game_time="60"
                    min_remaining_sec="1" />
                  <ChangeStance name="ChangeStanceApproachEnemyFortEnhancedMove" stance="ENHANCED_MOVE" cooldown="5.0" />
                </Sequence>
                <ChangeStance name="ChangeStanceApproachEnemyFortMove" stance="MOVE" cooldown="5.0" />
              </Fallback>
            </Sequence>
          </ReactiveFallback>
        </ReactiveSequence>

        <ReactiveFallback name="AbsoluteAttackBranch">
          <!-- 前哨站特殊响应:云台抬起且进入交战状态后优先消耗强化攻击时长,不可用则回退普通攻击。 -->
          <Sequence name="OutpostEnhancedAttackBranch">
            <CheckOutpostTarget goal_distance_threshold="0.5"
                                require_pitch_up="true" />
            <SetSpinState use_spin="true" />
            <Fallback name="OutpostAttackStanceSelector">
              <Sequence name="TryOutpostEnhancedAttack">
                <CheckEngagedStatus expected="true" />
                <CheckShouldEnhanceStance
                  target_stance="ATTACK"
                  accumulated_threshold="170"
                  fallback_game_time="60"
                  min_remaining_sec="1"
                  force_if_available="true" />
                <ChangeStance name="ChangeStanceOutpostEnhancedAttack" stance="ENHANCED_ATTACK" cooldown="5.0" />
              </Sequence>
              <ChangeStance name="ChangeStanceOutpostAttack" stance="ATTACK" />
            </Fallback>
          </Sequence>

          <Sequence name="HeatAttackBranch">
            <CheckHeat threshold="200" mode="greater" />
            <!-- <CheckStanceEffectLimit target_stance="ATTACK" max_time_sec="180" /> -->
            <SetSpinState use_spin="true" />
            <Fallback name="AbsoluteAttackStanceSelector">
              <Sequence name="TryEnhancedAttack">
                <CheckShouldEnhanceStance
                  target_stance="ATTACK"
                  accumulated_threshold="170"
                  fallback_game_time="60"
                  min_remaining_sec="1" />
                <ChangeStance name="ChangeStanceAbsoluteEnhancedAttack" stance="ENHANCED_ATTACK" cooldown="5.0" />
              </Sequence>
              <ChangeStance name="ChangeStanceAbsoluteAttack" stance="ATTACK" cooldown="5.0" />
            </Fallback>
          </Sequence>
        </ReactiveFallback>

        <Sequence name="CombatAttackBranch">
          <CheckEngagedStatus expected="true" />
          <CheckHealth threshold="50" mode="greater" />
          <!-- <CheckStanceEffectLimit target_stance="ATTACK" max_time_sec="180" /> -->
          <SetSpinState use_spin="true" />
          <Fallback name="CombatAttackStanceSelector">
            <Sequence name="TryEnhancedAttack">
              <CheckShouldEnhanceStance
                target_stance="ATTACK"
                accumulated_threshold="170"
                fallback_game_time="60"
                min_remaining_sec="1" />
              <ChangeStance name="ChangeStanceCombatEnhancedAttack" stance="ENHANCED_ATTACK" cooldown="5.0" />
            </Sequence>
            <ChangeStance name="ChangeStanceCombatAttack" stance="ATTACK" cooldown="5.0" />
          </Fallback>
        </Sequence>

        <Sequence name="DefendStanceBranch">
          <CheckEngagedStatus expected="true" />
          <CheckHealth threshold="50" mode="less" />
          <!-- <CheckStanceEffectLimit target_stance="DEFEND" max_time_sec="180" /> -->
          <SetSpinState use_spin="true" />
          <Fallback name="DefendStanceSelector">
            <Sequence name="TryEnhancedDefend">
              <CheckShouldEnhanceStance
                target_stance="DEFEND"
                accumulated_threshold="170"
                fallback_game_time="60"
                min_remaining_sec="1" />
              <ChangeStance name="ChangeStanceEnhancedDefend" stance="ENHANCED_DEFEND" cooldown="5.0" />
            </Sequence>
            <ChangeStance name="ChangeStanceDefend" stance="DEFEND" cooldown="5.0" />
          </Fallback>
        </Sequence>

        <Sequence name="MoveStanceSpinBranch">
          <Fallback name="MoveSpinConditions">
            <CheckCapacitorCapacity threshold="30" mode="less" />
            <CheckEngagedStatus expected="false" />
          </Fallback>
          <SetSpinState use_spin="true" />
          <Fallback name="MoveStanceSelector">
            <Sequence name="TryEnhancedMove">
              <CheckShouldEnhanceStance
                target_stance="MOVE"
                accumulated_threshold="170"
                fallback_game_time="60"
                min_remaining_sec="1" />
              <ChangeStance name="ChangeStanceEnhancedMove" stance="ENHANCED_MOVE" cooldown="5.0" />
            </Sequence>
            <!-- <Sequence name="DisengagedHighlandDefendBranch">
              <Inverter>
                CheckInZone zone_name="own_defend" />
              </Inverter>
              <ChangeStance name="ChangeStanceDisengagedHighlandDefend" stance="DEFEND" />
            </Sequence> -->
            <ChangeStance name="ChangeStanceMoveWithSpin" stance="MOVE" cooldown="5.0" />
          </Fallback>
        </Sequence>
        
        <Sequence name="DefaultDefendBranch">
          <SetSpinState use_spin="true" />
          <Fallback name="DefaultDefendStanceSelector">
            <Sequence name="TryEnhancedDefend">
              <CheckShouldEnhanceStance
                target_stance="DEFEND"
                accumulated_threshold="170"
                fallback_game_time="60"
                min_remaining_sec="1" />
              <ChangeStance name="DefaultEnhancedDefendStance" stance="ENHANCED_DEFEND" cooldown="5.0" />
            </Sequence>
            <ChangeStance name="DefaultDefendStance" stance="DEFEND" cooldown="5.0" />
          </Fallback>
        </Sequence>

      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>
</root>
